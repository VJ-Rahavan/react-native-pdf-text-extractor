{
  "name": "react-native-pdf-text-extractor",
  "version": "0.1.0",
  "description": "Fully offline, on-device PDF text extraction for React Native (iOS PDFKit, Android PdfBox-Android)",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "android/build.gradle",
    "android/src",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "example": "yarn --cwd example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli lib example/android/build example/android/app/build example/ios/build",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "pdf",
    "pdf-text",
    "pdfkit",
    "pdfbox",
    "offline",
    "text-extraction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayarahavank/react-native-pdf-text-extractor.git"
  },
  "author": "Vijayarahavan K <vijayarahavan.k@purplescape.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vijayarahavank/react-native-pdf-text-extractor/issues"
  },
  "homepage": "https://github.com/vijayarahavank/react-native-pdf-text-extractor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "workspaces": [
    "example"
  ],
  "devDependencies": {
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^6.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "kotlin-swift",
    "version": "0.63.0"
  },
  "codegenConfig": {
    "name": "RnPdfTextExtractorSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.pdftextextractor"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
